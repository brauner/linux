commit 134aeccf9e46e6e6b2e9c6d51aa10bf506799b23
Author: Christian Brauner <brauner@kernel.org>
Date:   Tue Nov 10 12:09:24 2026 +0100

    fixup! vfs: prepare vfs_creat|mkdir_no_perm for reuse in lookup_open()

    Let the two helpers do the "no ->create()/->mkdir()" check themselves
    and give vfs_create_no_perm() the parent inode like vfs_mkdir_no_perm()
    already has. vfs_create(), vfs_mkdir() and lookup_open() don't need
    their own copies then and "vfs: move ->create check in lookup_open() to
    before try_break_deleg()" can be dropped. Define vfs_mkdir_no_perm()
    next to vfs_create_no_perm() so that lookup_open() can use it without
    a forward declaration.

    Signed-off-by: Christian Brauner (Amutable) <brauner@kernel.org>

diff --git a/fs/namei.c b/fs/namei.c
index 34e146dc7ce47..9dfb3a2f9afee 100644
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -4188,12 +4188,15 @@ static inline umode_t vfs_prepare_mode(const struct mnt_idmap *idmap,
 }

 static inline
-int vfs_create_no_perm(const struct mnt_idmap *idmap, struct dentry *dentry,
-		       umode_t mode, struct delegated_inode *di)
+int vfs_create_no_perm(const struct mnt_idmap *idmap, struct inode *dir,
+		       struct dentry *dentry, umode_t mode,
+		       struct delegated_inode *di)
 {
-	struct inode *dir = d_inode(dentry->d_parent);
 	int error;

+	if (!dir->i_op->create)
+		return -EACCES;
+
 	error = try_break_deleg(dir, LEASE_BREAK_DIR_CREATE, di);
 	if (error)
 		return error;
@@ -4205,6 +4208,36 @@ int vfs_create_no_perm(const struct mnt_idmap *idmap, struct dentry *dentry,
 	return error;
 }

+static inline
+struct dentry *vfs_mkdir_no_perm(const struct mnt_idmap *idmap, struct inode *dir,
+				 struct dentry *dentry, umode_t mode,
+				 struct delegated_inode *di)
+{
+	unsigned int max_links = dir->i_sb->s_max_links;
+	struct dentry *de;
+	int error;
+
+	if (!dir->i_op->mkdir)
+		return ERR_PTR(-EPERM);
+
+	if (max_links && dir->i_nlink >= max_links)
+		return ERR_PTR(-EMLINK);
+
+	error = try_break_deleg(dir, LEASE_BREAK_DIR_CREATE, di);
+	if (error)
+		return ERR_PTR(error);
+
+	de = dir->i_op->mkdir(idmap, dir, dentry, mode);
+	if (IS_ERR(de))
+		return de;
+	if (de) {
+		dput(dentry);
+		dentry = de;
+	}
+	fsnotify_mkdir(dir, dentry);
+	return dentry;
+}
+
 /**
  * vfs_create - create new file
  * @idmap:	idmap of the mount the inode was found from
@@ -4230,15 +4263,12 @@ int vfs_create(const struct mnt_idmap *idmap, struct dentry *dentry, umode_t mod
 	if (error)
 		return error;

