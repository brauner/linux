commit 69ff66ff54ce890285b3fd929a6e2213f6553ff0
Author: Christian Brauner <brauner@kernel.org>
Date:   Tue Nov 10 12:09:26 2026 +0100

    fixup! vfs: add O_CREAT|O_DIRECTORY to open*(2)

    kernfs doesn't need the kernfs_syscall_ops change. The parent's i_rwsem
    is held across ->mkdir(), so once scops->mkdir() has returned the new
    node can be looked up by name under kernfs_rwsem, which is what the
    next ->lookup() would have done anyway. This leaves cgroup, resctrl and
    the kernfs_syscall_ops API untouched.

    While at it, drop the unused @lookup argument and the ->set() callback
    from kernfs_get_inode_locked(). Setting i_ino before inode_insert5() is
    enough.

    Signed-off-by: Christian Brauner (Amutable) <brauner@kernel.org>

diff --git a/fs/kernfs/dir.c b/fs/kernfs/dir.c
index abb6b0d212142..e72783843edbc 100644
--- a/fs/kernfs/dir.c
+++ b/fs/kernfs/dir.c
@@ -1292,13 +1292,17 @@ static struct dentry *kernfs_iop_mkdir(const struct mnt_idmap *idmap,
 				       umode_t mode)
 {
 	struct kernfs_node *parent = dir->i_private;
-	struct kernfs_syscall_ops *scops = kernfs_root(parent)->syscall_ops;
+	struct kernfs_root *root = kernfs_root(parent);
+	struct kernfs_syscall_ops *scops = root->syscall_ops;
+	const struct ns_common *ns = NULL;
 	struct kernfs_node *kn;
 	struct inode *inode;
+	int ret;

 	if (!scops || !scops->mkdir)
 		return ERR_PTR(-EOPNOTSUPP);

+	/* allocated up front so that we never fail after creating the node */
 	inode = new_inode(dir->i_sb);
 	if (!inode)
 		return ERR_PTR(-ENOMEM);
@@ -1308,18 +1312,31 @@ static struct dentry *kernfs_iop_mkdir(const struct mnt_idmap *idmap,
 		return ERR_PTR(-ENODEV);
 	}

-	kn = scops->mkdir(parent, dentry->d_name.name, mode);
+	ret = scops->mkdir(parent, dentry->d_name.name, mode);

 	kernfs_put_active(parent);
-	if (IS_ERR(kn)) {
+	if (ret) {
 		iput(inode);
-		return ERR_CAST(kn);
+		return ERR_PTR(ret);
 	}

-	scoped_guard(rwsem_read, &kernfs_root(kn)->kernfs_rwsem)
-		inode = kernfs_get_inode_locked(inode, kn, false);
-	kernfs_put(kn);
-
+	/*
+	 * Find the node that ->mkdir() created.  The parent's i_rwsem is
+	 * held, so only a removal from inside the kernel can make it go
+	 * away again, and then the open fails like one of a removed
+	 * directory.
+	 */
+	scoped_guard(rwsem_read, &root->kernfs_rwsem) {
+		if (kernfs_ns_enabled(parent))
+			ns = kernfs_info(dir->i_sb)->ns;
+		kn = kernfs_find_ns(parent, dentry->d_name.name, ns);
+		if (kn) {
+			inode = kernfs_get_inode_locked(inode, kn);
+		} else {
+			iput(inode);
+			inode = NULL;
+		}
+	}
 	if (!inode)
 		return ERR_PTR(-ESTALE);

